{
	"schemaVersion": 1,
	"id": "livingcity",
	"version": "${version}",
	"name": "我的世界盒子",
	"description": "让手工建造的城市活过来：市民日程、夜间安全契约、电梯垂直交通；并像 WorldBox 那样给悦灵等动物赋予人类智慧（万灵觉醒）。",
	"authors": [
		"YourName"
	],
	"contact": {},
	"license": "CC0-1.0",
	"icon": "assets/livingcity/icon.png",
	"environment": "*",
	"mixins": [
		"livingcity.mixins.json",
		{"config": "livingcity.client.mixins.json", "environment": "client"}
	],
	"entrypoints": {
		"main": [
			"com.livingcity.LivingCityMod"
		],
		"client": [
			"com.livingcity.LivingCityClient"
		],
		"fabric-datagen": [
			"com.livingcity.datagen.LivingCityDataGenerator"
		]
	},
	"depends": {
		"fabricloader": ">=0.16.10",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}
